# Orpheus-FastAPI Configuration
# Copy this file to .env and customize as needed

# Server connection settings
ORPHEUS_API_URL=http://localhost:5006/v1/completions

ORPHEUS_API_TIMEOUT=120 # You should scale this value based on max tokens and your inference speed

# Generation parameters
ORPHEUS_MAX_TOKENS=8192 # If you want longer completions, increase this value
ORPHEUS_TEMPERATURE=0.6
ORPHEUS_TOP_P=0.9
# Repetition penalty is now hardcoded to 1.1 for stability (this is a model constraint) - this setting is no longer used
# ORPHEUS_REPETITION_PENALTY=1.1
ORPHEUS_SAMPLE_RATE=24000
# Model configuration
# Option 1: Use pre-converted GGUF model (legacy)
# ORPHEUS_MODEL_NAME=Orpheus-3b-FT-Q8_0.gguf

# Option 2: Use HuggingFace repository with safetensors (new)
ORPHEUS_HF_REPO=dr-flex/orpheus-lena # HuggingFace repository containing the model
ORPHEUS_MODEL_TYPE=fp16 # Model precision: fp16 or fp32
ORPHEUS_CONVERT_TO_GGUF=true # Whether to convert safetensors to GGUF format

# Llama server performance tuning (for 16-bit models)
LLAMA_THREADS=8 # CPU threads for processing
LLAMA_BATCH_SIZE=32768 # Batch size for prompt processing (increased for fp16)
LLAMA_UBATCH_SIZE=16384 # Micro-batch size for decoding
LLAMA_CTX_SIZE=49152 # Context size (increased for larger models)
LLAMA_PARALLEL=4 # Number of parallel sequences
LLAMA_THREADS_HTTP=4 # HTTP server threads

# Web UI settings (keep in mind that the web UI is not secure and should not be exposed to the internet)
ORPHEUS_PORT=5005
ORPHEUS_HOST=0.0.0.0
