# Dockerfile for model conversion service
# Converts HuggingFace safetensors models to GGUF format

# Use official llama.cpp image with all conversion tools
FROM ghcr.io/ggml-org/llama.cpp:full-cuda

# Install git-lfs for cloning HuggingFace repos
USER root
RUN apt-get update && apt-get install -y \
    git \
    git-lfs \
    && rm -rf /var/lib/apt/lists/*

# Create directories for models
RUN mkdir -p /models/hf /models/gguf

# Add conversion script
COPY scripts/convert_model.sh /app/convert_model.sh
RUN chmod +x /app/convert_model.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV HF_HUB_ENABLE_HF_TRANSFER=1

WORKDIR /app

# Default command
CMD ["/app/convert_model.sh"]