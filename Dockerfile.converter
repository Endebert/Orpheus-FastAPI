# Dockerfile for model conversion service
# Converts HuggingFace safetensors models to GGUF format

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    git-lfs \
    build-essential \
    cmake \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Clone llama.cpp for conversion tools
RUN git clone https://github.com/ggerganov/llama.cpp.git /app/llama.cpp

# Build llama.cpp
WORKDIR /app/llama.cpp
RUN make -j$(nproc)

# Install Python dependencies for conversion
RUN pip install --no-cache-dir \
    numpy \
    sentencepiece \
    transformers \
    protobuf \
    torch \
    safetensors \
    gguf

# Create directories for models
RUN mkdir -p /models/hf /models/gguf

# Add conversion script
COPY scripts/convert_model.sh /app/convert_model.sh
RUN chmod +x /app/convert_model.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV HF_HUB_ENABLE_HF_TRANSFER=1

WORKDIR /app

# Default command
CMD ["/app/convert_model.sh"]